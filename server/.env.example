# Copy the values you need into the server's environment (or a process manager
# such as systemd / pm2). None are required for local development.

# production enables Secure cookies (the site must then be served over HTTPS)
NODE_ENV=production
PORT=3000
# 0.0.0.0 to accept connections from other machines; keep 127.0.0.1 behind a reverse proxy
HOST=127.0.0.1

# where the SQLite database lives (default: server/data/nadwicenter.db). Back this file up.
DATABASE_FILE=/var/lib/nadwicenter/nadwicenter.db

# the public address, used to reject requests that come from other websites
PUBLIC_ORIGIN=https://abulhasanalinadwi.org

# true when behind nginx/Cloudflare so rate limits see the real visitor IP
TRUST_PROXY=true

# session lifetime
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# only to test a production setup over plain http locally
# COOKIE_SECURE=false

# only for automated setup: password used by `npm run create-admin` instead of prompting
# ADMIN_PASSWORD=
